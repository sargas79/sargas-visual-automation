{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargas79/sargas-visual-automation/rules/rulepack.schema.json",
  "title": "Sargas Visual Automation rule pack",
  "description": "Default automation rules for one game system (rules/<systemId>.json). See rules/README.md.",
  "type": "object",
  "required": ["system", "version", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "system": {
      "type": "string",
      "minLength": 1,
      "description": "Foundry game.system.id / adapter id, e.g. \"pf2e\"."
    },
    "version": { "const": 1 },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "stringOrList": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["id", "match", "recipe"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique in the pack. A world rule with the same id overrides it."
        },
        "label": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "priority": { "type": "number", "default": 0, "description": "Higher runs first." },
        "match": { "$ref": "#/$defs/match" },
        "recipe": { "$ref": "#/$defs/recipe" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Every given criterion must match. Lists mean \"any of\" except traits (all required). Case-insensitive.",
      "properties": {
        "key": { "$ref": "#/$defs/stringOrList" },
        "name": { "$ref": "#/$defs/stringOrList" },
        "regex": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "required": ["pattern"],
              "additionalProperties": false,
              "properties": { "pattern": { "type": "string", "minLength": 1 }, "flags": { "type": "string" } }
            }
          ]
        },
        "type": { "$ref": "#/$defs/stringOrList" },
        "traits": { "$ref": "#/$defs/stringOrList" },
        "attackKind": { "$ref": "#/$defs/stringOrList" },
        "weaponGroup": { "$ref": "#/$defs/stringOrList" }
      }
    },
    "stage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["animation"],
          "additionalProperties": false,
          "properties": {
            "animation": { "type": "string", "minLength": 1 },
            "options": { "type": "object" }
          }
        }
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cast": { "$ref": "#/$defs/stage" },
        "projectile": { "$ref": "#/$defs/stage" },
        "impact": { "$ref": "#/$defs/stage" },
        "onSource": { "$ref": "#/$defs/stage" },
        "onTarget": { "$ref": "#/$defs/stage" }
      }
    },
    "sound": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "delay": { "type": "number" }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "animation": { "type": "string", "minLength": 1 },
        "options": { "type": "object" },
        "stages": { "$ref": "#/$defs/stages" },
        "sound": { "$ref": "#/$defs/sound" }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["preset"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "label": { "type": "string" },
        "preset": { "enum": ["melee", "ranged", "onToken", "area", "aura", "teleport"] },
        "animation": { "type": "string", "minLength": 1, "description": "JB2A database path (jb2a.…) or a file URL." },
        "options": { "type": "object" },
        "stages": { "$ref": "#/$defs/stages" },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "criticalSuccess": { "$ref": "#/$defs/override" },
            "success": { "$ref": "#/$defs/override" },
            "failure": { "$ref": "#/$defs/override" },
            "criticalFailure": { "$ref": "#/$defs/override" },
            "hit": { "$ref": "#/$defs/override" },
            "miss": { "$ref": "#/$defs/override" },
            "crit": { "$ref": "#/$defs/override" },
            "critical": { "$ref": "#/$defs/override" },
            "fumble": { "$ref": "#/$defs/override" },
            "criticalMiss": { "$ref": "#/$defs/override" }
          }
        },
        "sound": { "$ref": "#/$defs/sound" },
        "triggers": {
          "type": "array",
          "items": {
            "enum": ["attack", "damage", "cast", "save", "healing", "areaPlaced", "effectApplied", "effectRemoved"]
          }
        }
      }
    }
  }
}
