<section class="sva-grid-panel">
  {{#if unavailable}}
    <p class="sva-empty">{{localize "SVA.UI.Browser.Unavailable"}}</p>
  {{else}}
    <div class="sva-grid-toolbar">
      {{#if heading}}
        <h3 class="sva-grid-heading">{{heading}}</h3>
      {{else}}
        <ol class="sva-breadcrumbs">
          <li data-path=""><a data-action="selectNode"><i class="fa-solid fa-house" inert></i></a></li>
          {{#each crumbs}}
            <li data-path="{{path}}"><a data-action="selectNode">{{name}}</a></li>
          {{/each}}
        </ol>
      {{/if}}
      <span class="sva-muted sva-hint">{{localize "SVA.UI.Browser.PlayHint"}}</span>
    </div>
    <div class="sva-grid">
      {{#each cards}}
        <article
          class="{{cssClass}}"
          data-path="{{path}}"
          data-leaf="{{isLeaf}}"
          draggable="true"
          data-tooltip="{{path}}"
        >
          {{#if isLeaf}}
            <div class="sva-card-media">
              {{#if thumbnail}}
                <img src="{{thumbnail}}" loading="lazy" alt="" />
              {{else}}
                <i class="fa-solid fa-film sva-card-placeholder" inert></i>
              {{/if}}
            </div>
          {{else}}
            <a class="sva-card-media" data-action="selectNode">
              <i class="fa-solid fa-folder sva-card-placeholder" inert></i>
            </a>
          {{/if}}
          <div class="sva-card-name">{{name}}</div>
          <div class="sva-card-actions">
            {{#if pickMode}}
              <button type="button" data-action="pick" data-tooltip="SVA.UI.Browser.Pick">
                <i class="fa-solid fa-check" inert></i>
              </button>
            {{/if}}
            {{#if isLeaf}}
              <button type="button" data-action="play" data-tooltip="SVA.UI.Browser.Play">
                <i class="fa-solid fa-play" inert></i>
              </button>
            {{/if}}
            <button type="button" data-action="copy" data-tooltip="SVA.UI.Browser.CopyPath">
              <i class="fa-solid fa-copy" inert></i>
            </button>
            <button
              type="button"
              class="{{favClass}}"
              data-action="favourite"
              data-tooltip="SVA.UI.Browser.ToggleFavourite"
              aria-pressed="{{favourite}}"
            >
              <i class="{{favIcon}}" inert></i>
            </button>
          </div>
        </article>
      {{else}}
        <p class="sva-empty">{{localize emptyKey}}</p>
      {{/each}}
    </div>
    <footer class="sva-pager">
      {{#if pager.hasPrev}}
        <button type="button" data-action="pagePrev"><i class="fa-solid fa-chevron-left" inert></i></button>
      {{else}}
        <button type="button" disabled><i class="fa-solid fa-chevron-left" inert></i></button>
      {{/if}}
      <span>{{pager.label}}</span>
      {{#if pager.hasNext}}
        <button type="button" data-action="pageNext"><i class="fa-solid fa-chevron-right" inert></i></button>
      {{else}}
        <button type="button" disabled><i class="fa-solid fa-chevron-right" inert></i></button>
      {{/if}}
    </footer>
  {{/if}}
</section>