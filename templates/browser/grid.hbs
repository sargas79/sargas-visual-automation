<section class="sva-grid-panel">
  {{#if unavailable}}
    <p class="sva-empty">{{localize "SVA.UI.Browser.Unavailable"}}</p>
  {{else}}
    <div class="sva-grid-toolbar">
      {{#if heading}}
        <h3 class="sva-grid-heading">{{heading}}</h3>
      {{else}}
        <ol class="sva-breadcrumbs">
          <li data-path=""><a
              data-action="selectNode"
              data-tooltip="SVA.UI.Browser.Home"
              aria-label="{{localize 'SVA.UI.Browser.Home'}}"
            ><i class="fa-solid fa-house" inert></i></a></li>
          {{#each crumbs}}
            <li data-path="{{path}}"><a data-action="selectNode">{{name}}</a></li>
          {{/each}}
        </ol>
      {{/if}}
      <i
        class="fa-solid fa-circle-info sva-muted sva-hint"
        role="img"
        tabindex="0"
        data-tooltip="SVA.UI.Browser.PlayHint"
        aria-label="{{localize 'SVA.UI.Browser.PlayHint'}}"
      ></i>
    </div>
    <div class="sva-grid">
      {{#each cards}}
        <article
          class="{{cssClass}}"
          data-path="{{path}}"
          data-leaf="{{isLeaf}}"
          draggable="true"
          data-tooltip="{{path}}"
        >
          {{#if isLeaf}}
            <div class="sva-card-media">
              <span class="sva-card-placeholder" inert>
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                <span class="sva-card-placeholder-label">{{localize "SVA.UI.Browser.NoPreview"}}</span>
              </span>
              {{#if thumbnail}}
                <img src="{{thumbnail}}" loading="lazy" alt="" />
              {{/if}}
            </div>
          {{else}}
            <a class="sva-card-media" data-action="selectNode">
              <i class="fa-solid fa-folder sva-card-placeholder" inert></i>
            </a>
          {{/if}}
          <div class="sva-card-name">{{name}}</div>
          <div class="sva-card-actions">
            {{#if pickMode}}
              <button
                type="button"
                data-action="pick"
                data-tooltip="SVA.UI.Browser.Pick"
                aria-label="{{localize 'SVA.UI.Browser.Pick'}}"
              >
                <i class="fa-solid fa-check" inert></i>
              </button>
            {{/if}}
            {{#if isLeaf}}
              <button
                type="button"
                data-action="play"
                data-tooltip="SVA.UI.Browser.Play"
                aria-label="{{localize 'SVA.UI.Browser.Play'}}"
              >
                <i class="fa-solid fa-play" inert></i>
              </button>
            {{/if}}
            <button
              type="button"
              data-action="copy"
              data-tooltip="SVA.UI.Browser.CopyPath"
              aria-label="{{localize 'SVA.UI.Browser.CopyPath'}}"
            >
              <i class="fa-solid fa-copy" inert></i>
            </button>
            <button
              type="button"
              class="{{favClass}}"
              data-action="favourite"
              data-tooltip="SVA.UI.Browser.ToggleFavourite"
              aria-label="{{localize 'SVA.UI.Browser.ToggleFavourite'}}"
              aria-pressed="{{favourite}}"
            >
              <i class="{{favIcon}}" inert></i>
            </button>
          </div>
        </article>
      {{else}}
        <p class="sva-empty">{{localize emptyKey}}</p>
      {{/each}}
    </div>
    <footer class="sva-pager">
      <button
        type="button"
        class="sva-icon-button"
        data-action="pagePrev"
        data-tooltip="SVA.UI.Browser.PrevPage"
        aria-label="{{localize 'SVA.UI.Browser.PrevPage'}}"
        {{disabled pager.noPrev}}
      >
        <i class="fa-solid fa-chevron-left" inert></i>
      </button>
      <span>{{pager.label}}</span>
      <button
        type="button"
        class="sva-icon-button"
        data-action="pageNext"
        data-tooltip="SVA.UI.Browser.NextPage"
        aria-label="{{localize 'SVA.UI.Browser.NextPage'}}"
        {{disabled pager.noNext}}
      >
        <i class="fa-solid fa-chevron-right" inert></i>
      </button>
    </footer>
  {{/if}}
</section>