<header class="sva-browser-header">
  <label class="sva-search">
    <i class="fa-solid fa-magnifying-glass" inert></i>
    <input
      type="search"
      name="query"
      value="{{query}}"
      placeholder="{{localize 'SVA.UI.Browser.SearchPlaceholder'}}"
      aria-label="{{localize 'SVA.UI.Browser.SearchPlaceholder'}}"
      autocomplete="off"
    />
  </label>
  {{#if query}}
    <button type="button" class="sva-icon-button" data-action="clearSearch" data-tooltip="SVA.UI.Browser.ClearSearch">
      <i class="fa-solid fa-xmark" inert></i>
    </button>
  {{/if}}
  <button type="button" class="{{favouritesClass}}" data-action="showFavourites" aria-pressed="{{showFavourites}}">
    <i class="fa-solid fa-star" inert></i>
    {{localize "SVA.UI.Browser.Favourites"}}
  </button>
  {{#if pickMode}}<span class="sva-badge">{{localize "SVA.UI.Browser.PickMode"}}</span>{{/if}}
  {{#if provider}}<span class="sva-muted sva-provider">{{provider}}</span>{{/if}}
</header>