<div class="sva-recipe-form">
  <div class="form-group">
    <label for="{{idPrefix}}-preset">{{localize "SVA.UI.Recipe.Preset"}}</label>
    <div class="form-fields">
      <select id="{{idPrefix}}-preset" name="recipe.preset" data-sva-rerender>
        {{selectOptions presetOptions selected=preset}}
      </select>
    </div>
    {{#if presetHint}}<p class="hint">{{presetHint}}</p>{{/if}}
  </div>

  <div class="form-group">
    <label for="{{idPrefix}}-animation">{{localize "SVA.UI.Recipe.Animation"}}</label>
    <div class="form-fields sva-path-field">
      <input
        type="text"
        id="{{idPrefix}}-animation"
        name="recipe.animation"
        value="{{animation}}"
        placeholder="jb2a.fire_bolt.orange"
      />
      <button
        type="button"
        data-action="pickAnimation"
        data-target="recipe.animation"
        data-tooltip="SVA.UI.Recipe.Browse"
      >
        <i class="fa-solid fa-film" inert></i>
      </button>
    </div>
    <p class="hint">{{localize "SVA.UI.Recipe.AnimationHint"}}</p>
  </div>

  <fieldset class="sva-options">
    <legend>{{localize "SVA.UI.Recipe.Options"}}</legend>
    {{#each optionFields}}
      <div class="form-group">
        <label>{{localize label}}</label>
        <div class="form-fields sva-path-field">
          {{#if isCheckbox}}
            <input type="checkbox" name="{{name}}" {{checked checked}} />
          {{/if}}
          {{#if isNumber}}
            <input
              type="number"
              name="{{name}}"
              value="{{value}}"
              min="{{min}}"
              max="{{max}}"
              step="{{step}}"
              placeholder="{{placeholder}}"
            />
          {{/if}}
          {{#if isText}}
            <input type="text" name="{{name}}" value="{{value}}" placeholder="{{placeholder}}" />
          {{/if}}
          {{#if isSelect}}
            <select name="{{name}}">{{selectOptions options selected=value}}</select>
          {{/if}}
          {{#if isColor}}
            <color-picker name="{{name}}" value="{{value}}"></color-picker>
          {{/if}}
          {{#if isAnimation}}
            <input type="text" name="{{name}}" value="{{value}}" placeholder="{{placeholder}}" />
            <button
              type="button"
              data-action="pickAnimation"
              data-target="{{name}}"
              data-tooltip="SVA.UI.Recipe.Browse"
            >
              <i class="fa-solid fa-film" inert></i>
            </button>
          {{/if}}
          {{#if isJson}}
            <textarea name="{{name}}" rows="3" class="sva-json">{{value}}</textarea>
          {{/if}}
        </div>
        {{#if hint}}<p class="hint">{{localize hint}}</p>{{/if}}
      </div>
    {{else}}
      <p class="hint">{{localize "SVA.UI.Recipe.NoSchema"}}</p>
    {{/each}}
    <div class="form-group stacked">
      <label>{{localize "SVA.UI.Recipe.OptionsExtra"}}</label>
      <textarea name="recipe.optionsExtra" rows="3" class="sva-json" placeholder="{}">{{optionsExtra}}</textarea>
      <p class="hint">{{localize "SVA.UI.Recipe.OptionsExtraHint"}}</p>
    </div>
  </fieldset>

  <details class="sva-section">
    <summary>{{localize "SVA.UI.Recipe.StagesTitle"}}
      {{#if stagesSet}}<span class="sva-badge">{{stagesSet}}</span>{{/if}}</summary>
    <p class="hint">{{localize "SVA.UI.Recipe.StagesHint"}}</p>
    {{#each stages}}
      <div class="sva-subrecipe">
        <label class="sva-subrecipe-label">{{localize labelKey}}</label>
        <div class="form-fields sva-path-field">
          <input type="text" name="recipe.stages.{{key}}.animation" value="{{animation}}" placeholder="jb2a.…" />
          <button
            type="button"
            data-action="pickAnimation"
            data-target="recipe.stages.{{key}}.animation"
            data-tooltip="SVA.UI.Recipe.Browse"
          >
            <i class="fa-solid fa-film" inert></i>
          </button>
        </div>
        <textarea
          name="recipe.stages.{{key}}.options"
          rows="2"
          class="sva-json"
          placeholder="{{localize 'SVA.UI.Recipe.OptionsJson'}}"
        >{{options}}</textarea>
      </div>
    {{/each}}
  </details>

  <details class="sva-section">
    <summary>{{localize "SVA.UI.Recipe.OutcomesTitle"}}
      {{#if outcomesSet}}<span class="sva-badge">{{outcomesSet}}</span>{{/if}}</summary>
    <p class="hint">{{localize "SVA.UI.Recipe.OutcomesHint"}}</p>
    {{#each outcomes}}
      <div class="sva-subrecipe">
        <label class="sva-subrecipe-label">{{localize labelKey}}</label>
        <div class="form-fields sva-path-field">
          <input type="text" name="recipe.outcomes.{{key}}.animation" value="{{animation}}" placeholder="jb2a.…" />
          <button
            type="button"
            data-action="pickAnimation"
            data-target="recipe.outcomes.{{key}}.animation"
            data-tooltip="SVA.UI.Recipe.Browse"
          >
            <i class="fa-solid fa-film" inert></i>
          </button>
        </div>
        <textarea
          name="recipe.outcomes.{{key}}.options"
          rows="2"
          class="sva-json"
          placeholder="{{localize 'SVA.UI.Recipe.OptionsJson'}}"
        >{{options}}</textarea>
      </div>
    {{/each}}
  </details>

  <details class="sva-section">
    <summary>{{localize "SVA.UI.Recipe.SoundTitle"}}</summary>
    <div class="form-group">
      <label>{{localize "SVA.UI.Recipe.SoundFile"}}</label>
      <div class="form-fields"><input type="text" name="recipe.sound.file" value="{{sound.file}}" /></div>
    </div>
    <div class="form-group">
      <label>{{localize "SVA.UI.Recipe.SoundVolume"}}</label>
      <div class="form-fields">
        <input type="number" name="recipe.sound.volume" value="{{sound.volume}}" min="0" max="1" step="0.05" />
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "SVA.UI.Recipe.SoundDelay"}}</label>
      <div class="form-fields"><input
          type="number"
          name="recipe.sound.delay"
          value="{{sound.delay}}"
          min="0"
          step="50"
        /></div>
    </div>
  </details>

  <fieldset class="sva-triggers">
    <legend>{{localize "SVA.UI.Recipe.TriggersTitle"}}</legend>
    <div class="sva-checkbox-grid">
      {{#each triggers}}
        <label class="checkbox"><input type="checkbox" name="recipe.triggers.{{key}}" {{checked checked}} />
          {{localize labelKey}}</label>
      {{/each}}
    </div>
    <p class="hint">{{localize "SVA.UI.Recipe.TriggersHint"}}</p>
  </fieldset>
</div>