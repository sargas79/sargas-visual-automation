<section class="sva-rule-editor">
  {{#if editing}}
    <form class="sva-rule-form" autocomplete="off">
      <h3>
        {{#if rule.isNew}}
          {{localize "SVA.UI.Rules.NewRule"}}
        {{else}}
          {{localize "SVA.UI.Rules.EditRule"}}
        {{/if}}
      </h3>

      <div class="form-group">
        <label>{{localize "SVA.UI.Rules.Id"}}</label>
        <div class="form-fields">
          {{#if rule.isNew}}
            <input type="text" name="rule.id" value="{{rule.id}}" placeholder="{{localize 'SVA.UI.Rules.IdAuto'}}" />
          {{else}}
            <input type="text" name="rule.id" value="{{rule.id}}" readonly />
          {{/if}}
        </div>
      </div>
      <div class="form-group">
        <label>{{localize "SVA.UI.Rules.Label"}}</label>
        <div class="form-fields"><input type="text" name="rule.label" value="{{rule.label}}" /></div>
      </div>
      <div class="form-group">
        <label>{{localize "SVA.UI.Rules.Enabled"}}</label>
        <div class="form-fields"><input type="checkbox" name="rule.enabled" {{checked rule.enabled}} /></div>
      </div>
      <div class="form-group">
        <label>{{localize "SVA.UI.Rules.Priority"}}</label>
        <div class="form-fields"><input type="number" name="rule.priority" value="{{rule.priority}}" step="1" /></div>
        <p class="hint">{{localize "SVA.UI.Rules.PriorityHint"}}</p>
      </div>

      <fieldset>
        <legend>{{localize "SVA.UI.Rules.Match"}}</legend>
        <p class="hint">{{localize "SVA.UI.Rules.MatchHint"}}</p>
        <div class="form-group">
          <label>{{localize "SVA.UI.Rules.MatchKey"}}</label>
          <div class="form-fields"><input type="text" name="rule.match.key" value="{{rule.match.key}}" /></div>
        </div>
        <div class="form-group">
          <label>{{localize "SVA.UI.Rules.MatchName"}}</label>
          <div class="form-fields"><input type="text" name="rule.match.name" value="{{rule.match.name}}" /></div>
        </div>
        <div class="form-group">
          <label>{{localize "SVA.UI.Rules.MatchRegex"}}</label>
          <div class="form-fields"><input type="text" name="rule.match.regex" value="{{rule.match.regex}}" /></div>
        </div>
        <div class="form-group">
          <label>{{localize "SVA.UI.Rules.MatchType"}}</label>
          <div class="form-fields">
            <select name="rule.match.type">{{selectOptions rule.typeOptions selected=rule.match.type}}</select>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "SVA.UI.Rules.MatchTraits"}}</label>
          <div class="form-fields">
            <input type="text" name="rule.match.traits" value="{{rule.match.traits}}" placeholder="fire, cantrip" />
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "SVA.UI.Rules.MatchActorTraits"}}</label>
          <div class="form-fields">
            <input
              type="text"
              name="rule.match.actorTraits"
              value="{{rule.match.actorTraits}}"
              placeholder="dragon, size:large"
            />
          </div>
          <p class="hint">{{localize "SVA.UI.Rules.MatchActorTraitsHint"}}</p>
        </div>
        <div class="form-group">
          <label>{{localize "SVA.UI.Rules.MatchAttackKind"}}</label>
          <div class="form-fields">
            <select name="rule.match.attackKind">
              {{selectOptions rule.attackKindOptions selected=rule.match.attackKind}}
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "SVA.UI.Rules.MatchWeaponGroup"}}</label>
          <div class="form-fields">
            <input type="text" name="rule.match.weaponGroup" value="{{rule.match.weaponGroup}}" placeholder="sword" />
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "SVA.UI.Rules.MatchBaseItem"}}</label>
          <div class="form-fields">
            <input type="text" name="rule.match.baseItem" value="{{rule.match.baseItem}}" placeholder="longsword" />
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>{{localize "SVA.UI.Rules.Recipe"}}</legend>
        {{{recipeFormHtml}}}
      </fieldset>

      <footer class="sva-footer">
        <button type="button" data-action="cancelEdit">
          <i class="fa-solid fa-xmark" inert></i>
          {{localize "SVA.UI.Rules.Cancel"}}
        </button>
        <button type="submit">
          <i class="fa-solid fa-floppy-disk" inert></i>
          {{localize "SVA.UI.Rules.Save"}}
        </button>
      </footer>
    </form>
  {{else}}
    <p class="sva-empty">{{localize "SVA.UI.Rules.SelectHint"}}</p>
  {{/if}}
</section>