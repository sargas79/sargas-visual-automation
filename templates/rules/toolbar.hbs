<div class="sva-rules-toolbar">
  {{#unless unavailable}}
    <div class="sva-toolbar">
      <button type="button" data-action="addRule">
        <i class="fa-solid fa-plus" inert></i>
        <span>{{localize "SVA.UI.Rules.Add"}}</span>
      </button>
      <button type="button" data-action="importRules">
        <i class="fa-solid fa-file-import" inert></i>
        <span>{{localize "SVA.UI.Rules.Import"}}</span>
      </button>
      <button type="button" data-action="exportRules">
        <i class="fa-solid fa-file-export" inert></i>
        <span>{{localize "SVA.UI.Rules.Export"}}</span>
      </button>
      <input type="file" class="sva-import-input" accept=".json,application/json" hidden />
    </div>
    <div class="sva-toolbar sva-rules-filter">
      <label class="sva-search">
        <i class="fa-solid fa-magnifying-glass" inert></i>
        <input
          type="search"
          name="ruleQuery"
          value="{{state.query}}"
          placeholder="{{localize 'SVA.UI.Rules.SearchPlaceholder'}}"
          aria-label="{{localize 'SVA.UI.Rules.SearchPlaceholder'}}"
          autocomplete="off"
        />
      </label>
      <button
        type="button"
        class="sva-icon-button"
        data-action="clearSearch"
        data-tooltip="SVA.UI.Browser.ClearSearch"
        aria-label="{{localize 'SVA.UI.Browser.ClearSearch'}}"
        {{disabled noQuery}}
      >
        <i class="fa-solid fa-xmark" inert></i>
      </button>
      <label class="sva-sort">
        <span>{{localize "SVA.UI.Rules.Sort"}}</span>
        <select name="ruleSort">{{selectOptions sorts selected=state.sort}}</select>
      </label>
    </div>
  {{/unless}}
</div>