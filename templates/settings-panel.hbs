<div class="sva-settings-body">
  <nav class="sva-toolbar">
    <button type="button" data-action="openBrowser">
      <i class="fa-solid fa-film" inert></i>
      {{localize "SVA.UI.Browser.Title"}}
    </button>
    {{#if isGM}}
      <button type="button" data-action="openRules">
        <i class="fa-solid fa-list-check" inert></i>
        {{localize "SVA.UI.Rules.Title"}}
      </button>
    {{/if}}
  </nav>

  <div class="sva-scroll">
    {{#each groups}}
      <fieldset class="sva-settings-group">
        <legend>{{localize labelKey}}</legend>
        <p class="hint">{{localize hintKey}}</p>
        {{#each fields}}
          <div class="form-group">
            <label for="sva-setting-{{id}}">
              {{localize name}}
              {{#if requiresReload}}
                <i class="fa-solid fa-rotate sva-muted" data-tooltip="SVA.UI.SettingsPanel.RequiresReload"></i>
              {{/if}}
            </label>
            <div class="form-fields">
              {{#if isCheckbox}}
                <input type="checkbox" id="sva-setting-{{id}}" name="{{id}}" {{checked checked}} />
              {{/if}}
              {{#if isNumber}}
                <input type="number" id="sva-setting-{{id}}" name="{{id}}" value="{{value}}" step="{{step}}" />
              {{/if}}
              {{#if isRange}}
                <range-picker
                  id="sva-setting-{{id}}"
                  name="{{id}}"
                  value="{{value}}"
                  min="{{min}}"
                  max="{{max}}"
                  step="{{step}}"
                ></range-picker>
              {{/if}}
              {{#if isSelect}}
                <select id="sva-setting-{{id}}" name="{{id}}">{{selectOptions
                    options
                    selected=value
                    localize=true
                  }}</select>
              {{/if}}
              {{#if isText}}
                <input type="text" id="sva-setting-{{id}}" name="{{id}}" value="{{value}}" />
              {{/if}}
            </div>
            <p class="hint">
              {{#if hint}}{{localize hint}}{{/if}}
              <span class="sva-badge">{{localize scopeKey}}</span>
            </p>
          </div>
        {{/each}}
      </fieldset>
    {{else}}
      <p class="sva-empty">{{localize "SVA.UI.SettingsPanel.Empty"}}</p>
    {{/each}}
  </div>

  <footer class="sva-footer form-footer">
    <button type="submit">
      <i class="fa-solid fa-floppy-disk" inert></i>
      {{localize "SVA.UI.SettingsPanel.Save"}}
    </button>
  </footer>
</div>